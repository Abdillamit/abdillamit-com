# Copy to .env.local and fill in. .env.local is not committed.
# On Vercel set the same variables in Project → Settings → Environment Variables.

# Site address without a trailing slash: canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://abdillamit.dev

# --- Stage 2: Payload CMS ---------------------------------------------------

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Neon Postgres connection string (pooled), e.g.
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Local Docker database from the README:
# postgresql://payload:payload@localhost:5432/abdillamit
DATABASE_URI=

# S3-compatible storage for uploads (AWS S3 or Cloudflare R2).
# For R2 set S3_REGION=auto and S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket for images, e.g. https://media.abdillamit.dev
S3_PUBLIC_URL=

# --- Stage 5: contact form --------------------------------------------------

# Random string for hashing visitor IPs in the rate limit
IP_HASH_SALT=
